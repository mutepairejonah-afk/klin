# Live backend API base. Keep the /api suffix and use the same deployment
# configured in the backend CORS_ORIGIN allowlist.
VITE_API_BASE=https://kiln-api-ezfp.onrender.com/api

# Clerk publishable key (safe to expose client-side). Get from
# dashboard.clerk.com -> API Keys. Enable Google/GitHub/Vercel as social
# connections under User & Authentication -> SSO connections; email is on
# by default. Must match the CLERK_SECRET_KEY set on the backend.
# Use the publishable key from the same Clerk instance as CLERK_SECRET_KEY.
# Development keys are valid for the development deployment; never mix
# development and production Clerk instances.
VITE_CLERK_PUBLISHABLE_KEY=
