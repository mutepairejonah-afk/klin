# Backend API base (see kiln-backend). Include the /api suffix.
VITE_API_BASE=https://kiln-api-ezfp.onrender.com/api

# Clerk publishable key (safe to expose client-side). Get from
# dashboard.clerk.com -> API Keys. Enable Google/GitHub/Vercel as social
# connections under User & Authentication -> SSO connections; email is on
# by default. Must match the CLERK_SECRET_KEY set on the backend.
VITE_CLERK_PUBLISHABLE_KEY=
